# Copy to .env.local for local development. On Vercel add these under Project Settings > Environment Variables.
# NEVER commit real values. .env.local is git-ignored.

# ---- Database (Neon Postgres) ---------------------------------------------------------
# Used by the running site. Run `npm run db:setup` once: it creates the tables, a restricted database user
# ("portfolio_app") and writes this line into .env.local for you.
DATABASE_URL=postgresql://portfolio_app:<password>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require

# Owner connection, ONLY for `npm run db:setup` on your own computer. Do NOT add this to Vercel.
DATABASE_ADMIN_URL=postgresql://<owner>:<password>@<host>.<region>.aws.neon.tech/<db>?sslmode=require

# ---- Admin login (REQUIRED in production) ---------------------------------------------
# The password for /admin. Use 12+ characters.
# IMPORTANT: if it contains #, $, quotes or spaces, wrap it in double quotes in this file, e.g.
#   ADMIN_PASSWORD="my#long-pass phrase"
# Unquoted, everything after a # is treated as a comment and silently dropped, so the real password
# becomes shorter than the one you type. (On Vercel the value box needs no quotes.)
ADMIN_PASSWORD=
# A random string that signs login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# ---- Email copy of contact messages (optional) ----------------------------------------
# Messages are always saved in the database. With a free Resend account you also get each one by email.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Until you verify a domain with Resend leave this empty and use the email you signed up to Resend with as CONTACT_TO_EMAIL.
CONTACT_FROM=

# ---- Search engines (optional) --------------------------------------------------------
# Paste the verification codes from Google Search Console / Bing Webmaster Tools to prove you own the site.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---- Optional -------------------------------------------------------------------------
# Where the admin panel lives. Default: /kasitamim/admin. The plain /admin address returns 404.
# Lowercase letters, digits, "-" and "_", 1 to 4 segments. Changing it needs a rebuild/redeploy.
NEXT_PUBLIC_ADMIN_PATH=/kasitamim/admin

# Canonical site URL for SEO tags and the sitemap (Vercel's production URL is used if empty).
NEXT_PUBLIC_SITE_URL=
